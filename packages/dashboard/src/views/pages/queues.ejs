<section class="space-y-6">
  <% if (pollingInterval === 0) { %>
    <button type="button" class="btn btn-outline" onclick="htmx.trigger('#queues-table', 'toggleQueue')">Refresh</button>
  <% } %>
  <div class="card bg-neutral text-neutral-content shadow-lg">
    <div class="card-body">
      <div class="overflow-x-auto">
        <%- include('../partials/queues-table', { queues }) %>
      </div>
    </div>
  </div>
</section>
